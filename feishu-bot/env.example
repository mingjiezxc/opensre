# feishu-bot/env.example
#
# Placeholders only — never commit a real App Secret. Read from the environment
# at runtime (os.environ), the same way every other service in this repo does.

# --- Feishu app credentials (required) ---------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Delivery mode -----------------------------------------------------------
# ws       long connection (default): outbound WebSocket, no public URL needed
# webhook  request URL: Feishu POSTs to /webhook/event and /webhook/card
FEISHU_MODE=ws

# --- webhook mode only -------------------------------------------------------
# When set, every request must carry this token; when FEISHU_ENCRYPT_KEY is set,
# the encrypted envelope must decrypt. Both checks are mandatory if configured.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# --- Bot identity ------------------------------------------------------------
# Display name used in the welcome card (default OpenSRE).
FEISHU_BOT_NAME=OpenSRE
# Feishu tenant domain. Use https://open.larksuite.com for the international app.
FEISHU_DOMAIN=https://open.feishu.cn
# Optional: pin the bot's open_id instead of resolving it at startup via
# GET /open-apis/bot/v3/info. Needed only for offline/test runs.
FEISHU_BOT_OPEN_ID=

# --- HTTP port (webhook mode; ws mode does not listen) -----------------------
PORT=3979

# --- OpenSRE (shared with every IM bot) --------------------------------------
SRE_AGENT_URL=http://localhost:8000
INVESTIGATE_AUTH_TOKEN=
WEB_UI_PUBLIC_BASE_URL=http://localhost:3002
# Optional: attributes bot runs to a real org/team instead of local/default.
OPENSRE_TEAM_TOKEN=
